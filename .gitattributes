# 让 Git 自动判断文本文件，并将所有文本文件的行尾统一为 LF
* text=auto eol=lf

# 针对特定文件类型显式指定为 LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 声明二进制文件，防止 Git 误判并破坏它们
*.png binary
*.jpg binary
*.ico binary
*.pdf binary